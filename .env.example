# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
# Recommended for new projects. The legacy ANON key below remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Public Site URL (used in product interest messages and agent API)
# Ex: https://moveis-nascimento.com.br
VITE_PUBLIC_SITE_URL=
PUBLIC_SITE_URL=

# MCP server for n8n AI Agent tools
# Ex: http://localhost:3030/sse
MCP_PORT=3030
MCP_HOST=0.0.0.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MCP_AUTH_TOKEN=
